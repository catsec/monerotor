# Copy to .env and adjust. All state is bind-mounted here for portability.
# The blockchain is the big one — point it at a disk with room (pruned ~100GB).

MONERO_DIR=./data/monero     # blockchain (map to a host folder; copy in a synced
                             #   data.mdb to skip the slow over-Tor initial sync)
TOR_DIR=./data/tor           # onion identities (KEEP — this is your addresses)
CONFIG_DIR=./data/config     # monerod.conf, creds, ssh host key, backups drop-zone
BACKUP_DIR=./data/backups    # encrypted .age backups land here
