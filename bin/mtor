#!/bin/sh
# mtor — monerotor management CLI. Run the wizard once via the setup service;
# everything after that is `docker exec monerotor mtor …` on the live node.
#
#   setup            interactive first-run wizard
#   status           monerod sync status (restricted RPC, loopback)
#   onion            print the RPC onion and the RPC login
#   set <key> <val>  change a monerod.conf value (restart to apply)
#   logs [n]         tail the monerod log
#
# There is deliberately NO backup/restore: the onion identity is disposable
# (private node, 1-5 users — re-run setup, hand out the new address). This
# removes the riskiest code path (root tar-extract of a user-supplied file).
set -eu

CFG=/data/config; TOR=/data/tor; MON=/data/monero
CONF="$CFG/monerod.conf"; DEF=/etc/monerod.conf.default; MARKER="$CFG/.configured"

log() { printf '%s\n' "$*"; }
hr()  { printf -- '----------------------------------------------------------------------\n'; }
need_tty() { [ -t 0 ] || { echo "this needs an interactive terminal: docker compose run --rm -it setup"; exit 1; }; }

# Briefly run tor to mint the onion address so we can show it at setup time.
mint_onion() {
    # No CAP_DAC_OVERRIDE/CAP_FOWNER here: root only chowns the TOP-LEVEL dirs
    # (reachable via root-owned parents), then works inside them AS tor.
    mkdir -p /run/tor
    chown tor:tor "$TOR" /run/tor
    su-exec tor mkdir -p "$TOR/data" "$TOR/monero-rpc"
    su-exec tor chmod 700 "$TOR" "$TOR/monero-rpc" /run/tor
    if ! su-exec tor sh -c 'test -s /data/tor/monero-rpc/hostname'; then
        su-exec tor tor -f /etc/tor/torrc >/dev/null 2>&1 &
        tp=$!
        n=0; while [ "$n" -lt 30 ]; do
            su-exec tor sh -c 'test -s /data/tor/monero-rpc/hostname' && break
            n=$((n+1)); sleep 1
        done
        # CAP_KILL is dropped: root may not signal another uid's process, so
        # signal tor as its own user (SETUID is granted for exactly this).
        su-exec tor kill "$tp" 2>/dev/null || true; wait "$tp" 2>/dev/null || true
    fi
}

wizard() {
    need_tty
    if [ -f "$MARKER" ]; then
        log "Already configured. To start over: stop the node, delete the data"
        log "folders, run setup again (new onion + new password — new day)."
        exit 0
    fi
    hr; log "monerotor setup wizard"; hr

    printf 'Node type — [P]runed (~100GB, recommended) or [F]ull (~220GB+)? [P] '
    read -r t || true
    case "${t:-P}" in [Ff]*) prune=0 ;; *) prune=1 ;; esac

    # fixed username, random 16-char [a-z0-9] password — never asked, only shown
    ruser=monerotor
    rpass="$(tr -dc 'a-z0-9' < /dev/urandom | head -c 16)"

    # effective config
    cp "$DEF" "$CONF"
    if grep -q '^prune-blockchain=' "$CONF"; then
        sed -i "s/^prune-blockchain=.*/prune-blockchain=${prune}/" "$CONF"
    else
        echo "prune-blockchain=${prune}" >> "$CONF"
    fi
    echo "rpc-login=${ruser}:${rpass}" >> "$CONF"
    printf '%s:%s\n' "$ruser" "$rpass" > "$CFG/rpc_login"; chmod 600 "$CFG/rpc_login"

    mint_onion
    rpc_onion="$(su-exec tor cat "$TOR/monero-rpc/hostname" 2>/dev/null || echo '?')"
    echo "monero-rpc: ${rpc_onion}:18081" > "$CFG/onions.txt"

    touch "$MARKER"

    printf '\n'; hr
    log "!!  SAVE THESE — this is everything your wallet users need  !!"
    hr
    log "Onion address:  ${rpc_onion}"
    log "Port:           18081"
    log "RPC user:       ${ruser}"
    log "RPC password:   ${rpass}"
    hr
    log "(shown again anytime with:  docker exec monerotor mtor onion)"
    log "Setup complete. Start the node with:  docker compose up -d"
}

case "${1:-}" in
    setup)   wizard ;;
    # status must run INSIDE the node container (docker exec monerotor mtor
    # status) — the RPC binds the node's loopback. The wizard always sets an
    # rpc-login, so pass it or the one-shot client gets a 401.
    status)  if [ -s "$CFG/rpc_login" ]; then
                 monerod status --rpc-bind-port 18081 --rpc-login "$(cat "$CFG/rpc_login")" 2>/dev/null || echo "RPC not ready yet"
             else
                 monerod status --rpc-bind-port 18081 2>/dev/null || echo "RPC not ready yet"
             fi ;;
    onion)   cat "$CFG/onions.txt" 2>/dev/null || echo "onion not generated yet"
             echo "rpc-login: $(cat "$CFG/rpc_login" 2>/dev/null || echo '?')" ;;
    logs)    tail -n "${2:-100}" "$MON/monerod.log" 2>/dev/null || echo "no log yet" ;;
    set)     key="${2:?usage: mtor set <key> <value>}"; val="${3:?usage: mtor set <key> <value>}"
             sed -i "/^${key}=/d" "$CONF"; printf '%s=%s\n' "$key" "$val" >> "$CONF"
             log "set ${key}=${val}  (restart the node to apply)" ;;
    *)       echo "usage: mtor {setup|status|onion|logs [n]|set <k> <v>}"; exit 1 ;;
esac
