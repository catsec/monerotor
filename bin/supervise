#!/bin/sh
# monerotor node runtime (root PID1, minimal caps).
# Applies the kill-switch, then runs tor + vanguards + monerod as non-root
# users. If any long-running service dies, tears down so Docker restarts the
# container. There is NO remote management surface: admin is `docker exec`.
set -eu

CFG=/data/config; TOR=/data/tor; MON=/data/monero
log() { printf '[monerotor] %s\n' "$*"; }

# CAP_KILL is dropped, so root may not signal another uid's process: each
# daemon is signalled as its own user (SETUID covers this), and liveness is
# checked via /proc instead of `kill -0` (which would EPERM without CAP_KILL).
alive() { [ -d "/proc/$1" ]; }

term() {
    log "shutting down"
    # monerod first, while tor is still up so its Tor-side sockets can unwind.
    # Known wart: while syncing through torsocks, monerod's shutdown wedges on
    # network threads stuck in SOCKS connects (verified: TERM+INT ignored for
    # 5min+), so escalate to SIGKILL after a bounded wait. db-sync-mode is
    # safe:sync, which keeps LMDB consistent across a hard kill.
    if [ -n "${mon_pid:-}" ]; then
        su-exec monero kill "$mon_pid" 2>/dev/null || true
        i=0
        while [ -d "/proc/$mon_pid" ] && [ "$i" -lt 30 ]; do i=$((i+1)); sleep 1; done
        if [ -d "/proc/$mon_pid" ]; then
            log "monerod still up after 30s; force-killing (lmdb is in safe sync mode)"
            su-exec monero kill -9 "$mon_pid" 2>/dev/null || true
        fi
    fi
    if [ -n "${vg_pid:-}" ]; then
        su-exec tor kill "$vg_pid" 2>/dev/null || true
    fi
    if [ -n "${tor_pid:-}" ]; then
        su-exec tor kill "$tor_pid" 2>/dev/null || true
    fi
    wait 2>/dev/null || true
    exit 0
}
trap term TERM INT

# --- volume layout + ownership (CAP_CHOWN) ---
# Root here has neither CAP_DAC_OVERRIDE nor CAP_FOWNER (caps are minimal), so
# on a real filesystem root cannot even ENTER a 700 tor-owned dir, let alone
# chmod it. Rules: root only touches TOP-LEVEL dirs (reached via root-owned
# 755 parents, allowed); everything inside tor's dirs runs AS tor (su-exec).
# Mac bind mounts don't enforce any of this — only enforcing-fs tests catch it.
mkdir -p /run/tor
chown tor:tor "$TOR" /run/tor
# -R fixes files a user copied in as root (e.g. a synced chain); tolerate
# EACCES on interiors root can't traverse — the owners in there are already right
chown -R monero:monero "$MON" 2>/dev/null || true
su-exec tor mkdir -p "$TOR/data" "$TOR/monero-rpc"
su-exec tor chmod 700 "$TOR" "$TOR/monero-rpc" /run/tor

[ -f "$CFG/monerod.conf" ] || { log "no /data/config/monerod.conf — run: docker compose run --rm -it setup"; exit 1; }

# --- kill-switch (CAP_NET_ADMIN): only user 'tor' may egress ---
log "applying Tor-only kill-switch"
nft -f /etc/nftables/killswitch.nft

# --- tor: publishes the RPC onion ---
log "starting tor"
su-exec tor tor -f /etc/tor/torrc >/dev/null 2>&1 &
tor_pid=$!

log "waiting for onion..."
i=0
while [ "$i" -lt 90 ]; do
    if su-exec tor sh -c 'test -s /data/tor/monero-rpc/hostname && test -S /run/tor/control'; then break; fi
    i=$((i+1)); sleep 1
done
rpc_onion="$(su-exec tor cat "$TOR/monero-rpc/hostname" 2>/dev/null || echo '?')"
echo "monero-rpc: ${rpc_onion}:18081" > "$CFG/onions.txt"

# --- vanguards: guard-discovery defense for the onion service ---
# Runs as user tor (control-socket + cookie are tor-only). Logs to stdout so
# its security warnings land in `docker logs`. State persists across restarts.
log "starting vanguards"
su-exec tor vanguards --control_socket /run/tor/control \
    --state "$TOR/vanguards.state" &
vg_pid=$!

# --- blockchain presence (time saver) ---
# checked as user monero: root may lack search permission inside the data dir
if su-exec monero sh -c '[ -s /data/monero/lmdb/data.mdb ] || [ -s /data/monero/data.mdb ]'; then
    log "existing blockchain found in /data/monero — resuming (monerod verifies it)"
else
    log "no blockchain in /data/monero — will sync from scratch over Tor (slow)."
    log "  Tip: copy a synced pruned data.mdb into that folder to skip the sync."
fi

# --- monerod: torsocks routes EVERY connection through Tor ---
log "starting monerod (Tor-only)"
su-exec monero torsocks monerod --config-file "$CFG/monerod.conf" --non-interactive >/dev/null 2>&1 &
mon_pid=$!

log "up."
log "  monero RPC onion : ${rpc_onion}:18081"
log "  manage locally   : docker exec monerotor mtor status"

# --- supervise: if any service exits, restart the container ---
while alive "$tor_pid" && alive "$vg_pid" && alive "$mon_pid"; do
    sleep 5
done
log "a service exited; stopping so Docker can restart"
term
