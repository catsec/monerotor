# monerotor default monerod config.
# The wizard copies this to /data/config/monerod.conf and appends an rpc-login.
# monerod is launched wrapped in torsocks, so EVERY connection it makes goes
# through Tor; it binds only to loopback and is reachable solely via its onion.

data-dir=/data/monero
log-file=/data/monero/monerod.log
log-level=0
max-log-file-size=10485760

# Pruned personal node by default (wizard can set full).
prune-blockchain=1
sync-pruned-blocks=1
db-sync-mode=safe:sync

# Loopback only — no clearnet listeners. Reachable via the Tor hidden service.
p2p-bind-ip=127.0.0.1
p2p-bind-port=18080
rpc-bind-ip=127.0.0.1
rpc-bind-port=18081
restricted-rpc=1

# Never announce / never UPnP. torsocks + the kill-switch keep it Tor-only.
no-igd=1
hide-my-port=1
pad-transactions=1
out-peers=16
in-peers=32

# rpc-login=<user>:<pass>   <-- appended by the setup wizard
